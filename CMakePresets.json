{
    "version": 6,
    "configurePresets": [
        {
            "name": "cross-compile",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/PI.cmake",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
                "VCPKG_TARGET_TRIPLET": "arm64-rpi",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "emulator",
            "binaryDir": "${sourceDir}/emulator_build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_MAKE_PROGRAM": "ninja",
                "ENABLE_EMULATOR": true,
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "desktop",
            "hidden": true,
            "binaryDir": "${sourceDir}/desktop_build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ENABLE_DESKTOP": true,
                "ENABLE_SCENE_WORKER": true
            }
        },
        {
            "name": "desktop-linux",
            "inherits": "desktop",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "ninja"
            }
        },
        {
            "name": "desktop-windows",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "inherits": "desktop",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "ninja"
            }
        },
        {
            "name": "desktop-windows-debug",
            "binaryDir": "${sourceDir}/desktop_build_debug",
            "cacheVariables": {
                "DESKTOP_DEBUG_CONSOLE": true
            },
            "inherits": "desktop-windows"
        },
        {
            "name": "emulator-asan",
            "inherits": "emulator",
            "displayName": "emulator + ASan/UBSan",
            "binaryDir": "${sourceDir}/emulator_asan_build",
            "cacheVariables": {
                "LED_MATRIX_SANITIZE": "address",
                "SKIP_WEB_BUILD": true
            }
        },
        {
            "name": "emulator-tsan",
            "inherits": "emulator",
            "displayName": "emulator + TSan",
            "binaryDir": "${sourceDir}/emulator_tsan_build",
            "cacheVariables": {
                "LED_MATRIX_SANITIZE": "thread",
                "SKIP_WEB_BUILD": true
            }
        },
        {
            "name": "desktop-linux-asan",
            "inherits": "desktop-linux",
            "displayName": "desktop-linux + ASan/UBSan",
            "binaryDir": "${sourceDir}/desktop_asan_build",
            "cacheVariables": {
                "LED_MATRIX_SANITIZE": "address",
                "SKIP_WEB_BUILD": true
            }
        },
        {
            "name": "desktop-linux-tsan",
            "inherits": "desktop-linux",
            "displayName": "desktop-linux + TSan",
            "binaryDir": "${sourceDir}/desktop_tsan_build",
            "cacheVariables": {
                "LED_MATRIX_SANITIZE": "thread",
                "SKIP_WEB_BUILD": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cross-compile",
            "configurePreset": "cross-compile"
        },
        {
            "name": "emulator",
            "configurePreset": "emulator"
        },
        {
            "name": "desktop-linux",
            "configurePreset": "desktop-linux"
        },
        {
            "name": "desktop-windows",
            "configuration": "RelWithDebInfo",
            "configurePreset": "desktop-windows"
        },
        {
            "name": "desktop-windows-debug",
            "configurePreset": "desktop-windows-debug"
        },
        {
            "name": "emulator-asan",
            "configurePreset": "emulator-asan"
        },
        {
            "name": "emulator-tsan",
            "configurePreset": "emulator-tsan"
        },
        {
            "name": "desktop-linux-asan",
            "configurePreset": "desktop-linux-asan"
        },
        {
            "name": "desktop-linux-tsan",
            "configurePreset": "desktop-linux-tsan"
        }
    ],
    "packagePresets": []
}
