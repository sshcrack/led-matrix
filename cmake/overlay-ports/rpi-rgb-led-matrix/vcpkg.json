{
    "name": "rpi-rgb-led-matrix",
    "version": "0.1.7",
    "description": "A C++ library for controlling RGB LED matrices on Raspberry Pi, with optional emulator support.",
    "homepage": "https://github.com/sshcrack/rpi-rgb-led-matrix",
    "license": "MIT",
    "features": {
        "emulator": {
            "description": "Matrix Emulator",
            "dependencies": [
                {
                    "name": "sdl2",
                    "platform": "!windows"
                }
            ]
        }
    },
    "dependencies": [
        {
            "name": "vcpkg-cmake",
            "host": true
        },
        {
            "name": "vcpkg-cmake-config",
            "host": true
        }
    ],
    "port-version": 3
}
