[Unit]
Description=LED Matrix Controller
After=network.target

[Service]
Type=simple
# rpi-rgb-led-matrix requires root to open /dev/mem for GPIO access.
# After matrix initialisation the library automatically drops privileges
# to pi:pi via --led-drop-priv-user/--led-drop-priv-group in MATRIX_OPTS.
User=root
EnvironmentFile=/etc/default/led-matrix
ExecStart=/usr/bin/led-matrix $MATRIX_OPTS
WorkingDirectory=/var/lib/led-matrix
Restart=on-failure
# Let crashes leave a core dump for systemd-coredump (`coredumpctl list led-matrix`).
# The crash reporter writes its text report to /var/lib/led-matrix/crashes and
# then re-raises the signal so the kernel still dumps core. Because the process
# drops privileges after GPIO init, the kernel only dumps it when
# fs.suid_dumpable=2, which the systemd-coredump package configures.
LimitCORE=infinity

[Install]
WantedBy=multi-user.target
