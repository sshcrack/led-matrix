	(text "24 V -> 5 V power distribution and halo controller for the 2x2 HUB75 panel display"
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font (size 2.5 2.5) (bold yes))
			(justify left bottom)
		)
		(uuid "2845f68d-92fe-538c-9fbe-d2224631956c")
	)
	(text "Rev B, PROTOTYPE / UNVALIDATED, one-off hobby build. Input: 24 V brick (Mean Well GST160A24-R7B) via KPJX-PM-4S jack -> pigtail -> J1."
		(exclude_from_sim no)
		(at 25.4 150 0)
		(effects
			(font (size 1.5 1.5))
			(justify left bottom)
		)
		(uuid "deb852f5-8844-5a3d-93bc-88a0a34ecd49")
	)
	(text "Hot-plug into a running brick is supported: LM74700 ideal diode, SMBJ30A TVS, LM5069-2 hot-swap (inrush, 7.9 A limit, UV 17.9 V, OV 33.5 V)."
		(exclude_from_sim no)
		(at 25.4 155.08 0)
		(effects
			(font (size 1.5 1.5))
			(justify left bottom)
		)
		(uuid "cb4f8bfe-73c1-5029-a212-513b3a22e3ef")
	)
	(text "Two panel outputs, each feeding a pair of 5 V / 4 A panels: LM61495 buck (8 A) + TPS259823 eFuse (9.8 A limit) + M3.5 barrier terminal."
		(exclude_from_sim no)
		(at 25.4 160.16 0)
		(effects
			(font (size 1.5 1.5))
			(justify left bottom)
		)
		(uuid "68e396de-2b71-587d-ad61-1950039ee5bb")
	)
	(text "AUX: TPSM63610 for Pi, halo and logic; it starts only after the hot-swap reports power good (PGD on EN_AUX)."
		(exclude_from_sim no)
		(at 25.4 165.24 0)
		(effects
			(font (size 1.5 1.5))
			(justify left bottom)
		)
		(uuid "92ca428d-9c47-5a25-9985-5ff0b0d26d7a")
	)
	(text "HUB75 data stays on the Electrodragon RGB matrix driver V2 (MPC1119). This board never touches HUB75 pins."
		(exclude_from_sim no)
		(at 25.4 170.32 0)
		(effects
			(font (size 1.5 1.5))
			(justify left bottom)
		)
		(uuid "e866b085-a686-560b-906c-9849becd6de1")
	)
	(text "Pi interface: GPIO14 (TXD, UART to halo MCU) and GPIO26 (panel enable) only; both unused at --led-parallel=2."
		(exclude_from_sim no)
		(at 25.4 175.4 0)
		(effects
			(font (size 1.5 1.5))
			(justify left bottom)
		)
		(uuid "90e648e2-c187-5498-972e-f34e3f068c62")
	)
	(text "Software brightness limits are not protection: each panel pair is limited in hardware (eFuse, ~9.8 A)."
		(exclude_from_sim no)
		(at 25.4 180.48 0)
		(effects
			(font (size 1.5 1.5))
			(justify left bottom)
		)
		(uuid "a3dc5ae0-cdea-55c5-bdb4-5ad5ebba0aeb")
	)
